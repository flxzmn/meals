# Copy this file to .env and enter your own key.
# Never commit .env or real API keys.
USDA_API_KEY=replace_with_your_data_gov_key
# Default data folder: %APPDATA%/MealMCP (Windows), ~/Library/Application Support/MealMCP (macOS).
# MEAL_DATA_DIR=C:/path/to/folder
# Set DATABASE_URL only for an absolute path; a relative sqlite path breaks when Claude Desktop
# starts the server from another folder.
# DATABASE_URL=sqlite:///C:/path/to/recipe_mcp.db
MEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1
HTTP_TIMEOUT_SECONDS=30
MAX_CONCURRENT_REQUESTS=8
LOG_LEVEL=INFO
